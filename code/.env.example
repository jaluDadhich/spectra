# SPECTRA environment configuration — copy to .env and fill in values.
# NEVER commit a real .env or real secrets.

# --- OpenAI / GPT-assisted whole-submission review ---
# Put your secret key in code/.env (copy this file there); never commit .env.
# GPT review runs first when enabled; deterministic rules are the fallback.
OPENAI_API_KEY=your-openai-api-key
# Legacy single-model setting; fast/reasoning settings below override it.
OPENAI_MODEL=gpt-6-luna
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_REASONING_MODEL=gpt-6.1-sol
OPENAI_FAST_REASONING_EFFORT=low
OPENAI_REASONING_EFFORT=high
# Optional: only set if your deployment requires a compatible endpoint
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_SCOPE_TIMEOUT_SECONDS=180
OPENAI_SCOPE_MAX_OUTPUT_TOKENS=16000
OPENAI_MAX_REQUEST_TOKENS=25000
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=2000
# Only set if the chosen model/endpoint supports it
# OPENAI_TEMPERATURE=0.0

# --- LLM cost and safety controls ---
SPECTRA_LLM_ENABLED=true
SPECTRA_LLM_BUDGET_USD_PER_CASE=1.00
SPECTRA_MAX_LLM_CALLS_PER_CASE=12
SPECTRA_MAX_CONCURRENT_LLM_CALLS=2
# Scope evidence is bounded so a single prompt stays inside the request token ceiling.
SPECTRA_SCOPE_EVIDENCE_PAYLOAD_CHARS=42000

# --- Runtime ---
SPECTRA_LOG_LEVEL=INFO
SPECTRA_LOG_FILE=logs/spectra.log
DATABASE_URL=sqlite:///./data/spectra.db
SPECTRA_DATA_DIR=./data
SPECTRA_RULESET_DIR=./rulesets
SPECTRA_PROFILE_DIR=./profiles
# Model pricing estimates (USD per 1K tokens); defaults match GPT-6 Luna.
# GPT-6.1 Sol has a separate rate; override if model pricing changes.
SPECTRA_PRICE_INPUT_PER_1K=0.0001
SPECTRA_PRICE_OUTPUT_PER_1K=0.0005
SPECTRA_REASONING_PRICE_INPUT_PER_1K=0.002
SPECTRA_REASONING_PRICE_OUTPUT_PER_1K=0.01

# --- Approved external source adapters (disabled by default) ---
# Only configure approved, licensed sources. Each adapter requires explicit enablement.
# SPECTRA_EXT_STATE_REGISTRY_ENABLED=false
# SPECTRA_EXT_STATE_REGISTRY_API_KEY=
# SPECTRA_EXT_FMCSA_ENABLED=false
# SPECTRA_EXT_FMCSA_API_KEY=

# --- Optional public-record/news web search ---
# The review first uses local external_records JSON; this never calls out if
# such a document is present. Live search requires explicit opt-in + key.
SPECTRA_WEB_SEARCH_ENABLED=false
SPECTRA_WEB_SEARCH_API_KEY=
SPECTRA_WEB_SEARCH_URL=https://api.tavily.com/search
SPECTRA_WEB_SEARCH_CACHE_TTL_HOURS=168
